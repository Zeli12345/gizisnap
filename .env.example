APP_NAME=GiziSnap
APP_ENV=local
APP_KEY=
# Produksi: APP_ENV=production dan APP_DEBUG=false. Jangan pernah true di server.
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Makassar

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database: MySQL dari Laragon atau XAMPP. Buat database "gizisnap" dulu.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gizisnap
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ------------------------------------------------------------------
# GiziSnap
# Nilai rahasia dibagikan ketua lewat chat pribadi. JANGAN commit .env
# ------------------------------------------------------------------

# Login Google (Google Cloud Console > OAuth Client ID, tipe Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Akun Google dengan email ini otomatis menjadi admin
ADMIN_EMAIL=

# OpenAI (platform.openai.com > API keys). Berbayar, terpisah dari ChatGPT.
OPENAI_API_KEY=

# CommandCode: satu kunci untuk DeepSeek, GPT, Claude, Gemini, Qwen, GLM, Kimi.
# Daftar model: https://api.commandcode.ai/provider/v1/models
COMMANDCODE_API_KEY=
COMMANDCODE_URL=https://api.commandcode.ai/provider/v1
COMMANDCODE_MODEL=deepseek/deepseek-v4.1-flash

# Penyedia AI yang dipakai: openai atau commandcode
AI_PROVIDER=commandcode

# true = jawaban contoh tanpa memanggil AI. HANYA untuk pengembangan dan tes.
# Saat APP_ENV=production nilainya dipaksa false, jadi jawaban tiruan tidak
# pernah sampai ke pengguna.
AI_FAKE=true
AI_SCAN_MODEL=deepseek/deepseek-v4.1-flash
AI_CHAT_MODEL=deepseek/deepseek-v4.1-flash
# off | low | medium | high | xhigh | max  (max = paling teliti untuk gizi)
AI_REASONING_EFFORT=max
AI_TIMEOUT=120
AI_SCAN_MAX_TOKENS=4096
AI_CHAT_MAX_TOKENS=1500
AI_DAILY_SCAN_LIMIT=10
AI_DAILY_CHAT_LIMIT=30
AI_PER_MINUTE_LIMIT=5
